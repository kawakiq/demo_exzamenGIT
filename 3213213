## 1 вариант.

-- 1
CREATE TABLE clients (
    client_id INT AUTO_INCREMENT PRIMARY KEY,
    full_name VARCHAR(150) NOT NULL,
    phone VARCHAR(30),
    email VARCHAR(100)
);

-- 2
CREATE TABLE laptop_models (
    model_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(150) NOT NULL,
    description TEXT,
    image VARCHAR(255)
);

-- 3
CREATE TABLE laptop_configurations (
    configuration_id INT AUTO_INCREMENT PRIMARY KEY,
    model_id INT NOT NULL,
    ram VARCHAR(20) NOT NULL,
    ssd VARCHAR(20) NOT NULL,
    stock_quantity INT NOT NULL DEFAULT 0,

    FOREIGN KEY (model_id)
        REFERENCES laptop_models(model_id)
        ON DELETE CASCADE,

    CHECK (stock_quantity >= 0)
);

-- 4
CREATE TABLE order_statuses (
    status_id INT AUTO_INCREMENT PRIMARY KEY,
    name VARCHAR(50) NOT NULL UNIQUE
);

-- 5
CREATE TABLE orders (
    order_id INT AUTO_INCREMENT PRIMARY KEY,
    client_id INT NOT NULL,
    status_id INT NOT NULL,
    order_date DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,

    FOREIGN KEY (client_id)
        REFERENCES clients(client_id),

    FOREIGN KEY (status_id)
        REFERENCES order_statuses(status_id)
);

-- 6
CREATE TABLE order_items (
    order_item_id INT AUTO_INCREMENT PRIMARY KEY,
    order_id INT NOT NULL,
    configuration_id INT NOT NULL,
    quantity INT NOT NULL,

    FOREIGN KEY (order_id)
        REFERENCES orders(order_id)
        ON DELETE CASCADE,

    FOREIGN KEY (configuration_id)
        REFERENCES laptop_configurations(configuration_id),

    CHECK (quantity > 0)
);


